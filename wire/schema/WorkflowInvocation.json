{
  "$defs": {
    "ChatSubject": {
      "description": "The chat event a chat workflow run answers, in its source thread.",
      "properties": {
        "channel_id": {
          "title": "Channel Id",
          "type": "string"
        },
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "self_user_id": {
          "title": "Self User Id",
          "type": "string"
        },
        "service": {
          "title": "Service",
          "type": "string"
        },
        "thread_id": {
          "title": "Thread Id",
          "type": "string"
        }
      },
      "required": [
        "service",
        "channel_id",
        "thread_id",
        "event_id",
        "self_user_id"
      ],
      "title": "ChatSubject",
      "type": "object"
    },
    "Work": {
      "description": "The work a command run does, settled by the host that starts the run.\n\n``kind`` and ``identity`` key the member's conversation with each AI CLI\ntool; a ticket is identified by its URL, which is also its subject.\n``chat`` is the subject of a chat workflow run. Nothing the run passes\nchanges any of it.",
      "properties": {
        "chat": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChatSubject"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "identity": {
          "title": "Identity",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "identity"
      ],
      "title": "Work",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A workflow run the host started.\n\n``run_id`` and ``work`` are what the host selected the run for: the run\nits command records to, and the work its grant holds it to. A ticket or\nchat run has both; any other has neither.",
  "properties": {
    "command": {
      "title": "Command",
      "type": "string"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    },
    "person_id": {
      "title": "Person Id",
      "type": "string"
    },
    "run_id": {
      "default": "",
      "title": "Run Id",
      "type": "string"
    },
    "source": {
      "enum": [
        "routine",
        "scheduled",
        "event_queue",
        "manual"
      ],
      "title": "Source",
      "type": "string"
    },
    "trigger_type": {
      "enum": [
        "ticket",
        "chat",
        "scheduled",
        "generic"
      ],
      "title": "Trigger Type",
      "type": "string"
    },
    "work": {
      "anyOf": [
        {
          "$ref": "#/$defs/Work"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "command",
    "person_id",
    "source",
    "trigger_type"
  ],
  "title": "WorkflowInvocation",
  "type": "object"
}
