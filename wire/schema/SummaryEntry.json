    },
    "effort": {
      "default": "",
      "title": "Effort",
      "type": "string"
    },
    "model": {
      "default": "",
      "title": "Model",
      "type": "string"
    },
    "model_specified": {
      "title": "Model Specified",
      "type": "boolean"
    },
    "slot": {
      "title": "Slot",
      "type": "string"
    },
    "span": {
