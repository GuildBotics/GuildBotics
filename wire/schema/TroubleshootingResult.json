{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One assistant answer and the executions it used as evidence.",
  "properties": {
    "message": {
      "title": "Message",
      "type": "string"
    },
    "trace_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 10,
      "title": "Trace Ids",
      "type": "array"
    }
  },
  "required": [
    "message"
  ],
  "title": "TroubleshootingResult",
  "type": "object"
}
