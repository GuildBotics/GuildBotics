    "chat": {
      "anyOf": [
        {
          "$ref": "#/$defs/ChatSubject"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "identity": {
      "title": "Identity",
      "type": "string"
    },
    "kind": {
      "title": "Kind",
      "type": "string"
    }
  },
  "required": [
    "kind",
    "identity"
  ],
  "title": "Work",
  "type": "object"
