{
  "name": "branvil-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser GUI of Branvil (kanban, pull request review, settings).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "npm run build && cargo build --locked -p branvil --bin branvil && playwright test",
    "e2e:visual": "BRANVIL_E2E_VISUAL=1 playwright test",
    "e2e:perf": "BRANVIL_E2E_PERF=1 playwright test"
  },
  "dependencies": {
    "@mantine/core": "^9.5.1",
    "@mantine/hooks": "^9.5.1",
    "@tanstack/react-query": "^5.104.0",
    "lucide-react": "^1.30.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "@guildbotics/ui": "^0.1.0",
    "react-i18next": "^17.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24"
  }
}
