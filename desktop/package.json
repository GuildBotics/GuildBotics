{
  "name": "guildbotics-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{ts,json,html}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.{ts,json,html}\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "duplicates": "jscpd --config jscpd.config.json src ../packages/ui/src",
    "test": "vitest run && npm run test:e2e-preflight",
    "test:watch": "vitest",
    "test:e2e-preflight": "node --test e2e/preflight.test.mjs",
    "e2e": "node e2e/preflight.mjs && vite build && playwright test",
    "e2e:install": "playwright install chromium",
    "quality": "npm run quality --workspace @guildbotics/ui && npm run format:check && npm run lint && npm run typecheck && npm run duplicates && npm run test"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.6",
    "@mantine/core": "^9.5.1",
    "@mantine/form": "^9.5.1",
    "@mantine/hooks": "^9.5.1",
    "@mantine/notifications": "^9.5.1",
    "@tanstack/react-query": "^5.104.0",
    "codemirror": "^6.0.2",
    "i18next": "^26.3.0",
    "lucide-react": "^1.30.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.8",
    "react-router": "^8.3.0",
    "zod": "^4.6.7",
    "@guildbotics/ui": "^0.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.12.0",
    "jscpd": "^5.0.14",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
