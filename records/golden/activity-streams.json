  {
    "test": "test_agent_streams.py::test_completed_stream_drops_started_and_deltas (call)",
    "function": "collapse_assistant_streams",
    "arguments": {
      "records": [
        {
          "kind": "event",
          "type": "command.started",
          "payload": {}
        },
        {
          "kind": "event",
          "type": "agent_runtime.assistant",
          "span_id": "span-1",
          "payload": {
            "name": "started",
            "message": ""
          }
        },
        {
          "kind": "event",
          "type": "agent_runtime.assistant",
          "span_id": "span-1",
          "payload": {
            "name": "delta",
            "message": "Hel"
          }
        },
        {
          "kind": "event",
          "type": "agent_runtime.assistant",
          "span_id": "span-1",
          "payload": {
            "name": "delta",
            "message": "lo"
          }
        },
        {
          "kind": "event",
          "type": "agent_runtime.assistant",
          "span_id": "span-1",
          "payload": {
            "name": "completed",
            "message": "Hello"
          }
        },
        {
          "kind": "event",
          "type": "command.finished",
          "payload": {}
        }
      ]
    },
    "expected": [
      {
        "kind": "event",
        "type": "command.started",
        "payload": {}
      },
      {
        "kind": "event",
        "type": "agent_runtime.assistant",
        "span_id": "span-1",
        "payload": {
          "name": "completed",
          "message": "Hello"
        }
      },
      {
        "kind": "event",
        "type": "command.finished",
        "payload": {}
      }
    ]
  },
  {
    "test": "test_agent_streams.py::test_interrupted_stream_collapses_into_one_partial_record (call)",
    "function": "collapse_assistant_streams",
    "arguments": {
      "records": [
        {
          "kind": "event",
          "type": "agent_runtime.assistant",
          "span_id": "span-1",
          "payload": {
            "name": "started",
            "message": ""
          }
        },
        {
          "kind": "event",
          "type": "agent_runtime.assistant",
          "span_id": "span-1",
          "payload": {
            "name": "delta",
            "message": "partial "
          }
        },
        {
          "kind": "event",
          "type": "agent_runtime.assistant",
          "span_id": "span-1",
          "payload": {
            "name": "delta",
            "message": "output"
          }
        },
        {
          "kind": "event",
          "type": "span.failed",
          "payload": {}
        }
      ]
    },
    "expected": [
      {
        "kind": "event",
        "type": "agent_runtime.assistant",
        "span_id": "span-1",
        "payload": {
          "name": "partial",
          "message": "partial output",
          "partial": true
        }
      },
      {
        "kind": "event",
        "type": "span.failed",
        "payload": {}
      }
    ]
  },
