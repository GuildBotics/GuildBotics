  {
    "test": "test_agent_streams.py::test_reasoning_chunks_are_collapsed_into_one_record (call)",
    "function": "collapse_assistant_streams",
    "arguments": {
      "records": [
        {
          "kind": "event",
          "type": "agent_runtime.assistant",
          "span_id": "span-1",
          "payload": {
            "name": "thinking",
            "message": "The "
          }
        },
        {
          "kind": "event",
          "type": "agent_runtime.assistant",
          "span_id": "span-1",
          "payload": {
            "name": "thinking",
            "message": "user "
          }
        },
        {
          "kind": "event",
          "type": "agent_runtime.assistant",
          "span_id": "span-1",
          "payload": {
            "name": "thinking",
            "message": "wants "
          }
        },
        {
          "kind": "event",
          "type": "agent_runtime.assistant",
          "span_id": "span-1",
          "payload": {
            "name": "thinking",
            "message": "a path."
          }
        },
        {
          "kind": "event",
          "type": "agent_runtime.assistant",
          "span_id": "span-1",
          "payload": {
            "name": "delta",
            "message": "OK"
          }
        },
        {
          "kind": "event",
          "type": "agent_runtime.assistant",
          "span_id": "span-1",
          "payload": {
            "name": "completed",
            "message": "OK"
          }
        }
      ]
    },
    "expected": [
      {
        "kind": "event",
        "type": "agent_runtime.assistant",
        "span_id": "span-1",
        "payload": {
          "name": "thinking",
          "message": "The user wants a path."
        }
      },
      {
        "kind": "event",
        "type": "agent_runtime.assistant",
        "span_id": "span-1",
        "payload": {
          "name": "completed",
          "message": "OK"
        }
      }
    ]
  },
