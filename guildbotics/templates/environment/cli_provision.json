[
  {
    "name": "codex",
    "label": "Codex",
    "package": "@openai/codex@0.166.0",
    "install": "",
    "provision": {
      "package": "@openai/codex@0.166.0",
      "install": "",
      "state_root": ".codex",
      "state_root_env": "CODEX_HOME",
      "user_skills": ".agents/skills",
      "auth": "auth.json",
      "auth_env": "",
      "persisted": [
        "sessions/"
      ],
      "login": [
        "codex",
        "login",
        "--device-auth"
      ],
      "api_domains": [
        "chatgpt.com",
        "*.chatgpt.com",
        "api.openai.com",
        "auth.openai.com",
        "*.openai.com"
      ],
      "credential_broker": {
        "format": "codex-chatgpt",
        "access_token": [
          "tokens",
          "access_token"
        ],
        "refresh_token": [
          "tokens",
          "refresh_token"
        ],
        "expires_at": [
          "tokens",
          "access_token"
        ],
        "expires_format": "jwt",
        "turn_fields": [
          [
            "auth_mode"
          ],
          [
            "tokens",
            "account_id"
          ],
          [
            "last_refresh"
          ]
        ],
        "empty_refresh_token": true,
        "stand_in_claims_from": [
          "tokens",
          "id_token"
        ],
        "stand_in_claims": [
          [
            "email"
          ],
          [
            "https://api.openai.com/auth",
            "chatgpt_plan_type"
          ],
          [
            "https://api.openai.com/auth",
            "chatgpt_account_id"
          ]
        ],
        "upstream": "https://chatgpt.com",
        "routes": [
          "POST /backend-api/codex/responses",
          "GET /backend-api/codex/models",
          "GET /backend-api/wham/usage",
          "GET /backend-api/wham/accounts/check",
          "GET /backend-api/wham/rate-limit-reset-credits",
          "GET /backend-api/wham/settings/user",
          "GET /backend-api/ps/plugins/*",
          "GET /backend-api/plugins/featured",
          "POST /backend-api/ps/mcp"
        ],
        "base_url_env": [
          "GUILDBOTICS_CODEX_BASE_URL"
        ],
        "base_url_path": "/backend-api",
        "stand_in_command_env": "",
        "stand_in_env": "",
        "stand_in_also_env": [
          "CODEX_CONNECTORS_TOKEN"
        ],
        "stand_in_prefix": "guildbotics-stand-in-",
        "turn_environment": [],
        "tls": true,
        "relayed_hosts": [],
        "turn_domains": [],
        "refresh": [
          "codex",
          "debug",
          "models"
        ]
      }
    }
  },
