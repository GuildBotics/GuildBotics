          "ANTHROPIC_BASE_URL"
        ],
        "base_url_path": "",
        "stand_in_command_env": "",
        "stand_in_also_env": [],
        "stand_in_prefix": "guildbotics-stand-in-",
        "turn_environment": [
          [
            "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC",
            "1"
          ]
        ],
        "tls": false,
        "refresh": [
          "claude",
          "-p",
          "/usage",
          "--output-format",
          "json",
          "--no-session-persistence"
        ]
      }
    }
  },
