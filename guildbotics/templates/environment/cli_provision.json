          "claudeAiOauth",
          "refreshToken"
        ],
        "expires_at": [
          "claudeAiOauth",
          "expiresAt"
        ],
        "expires_format": "epoch_ms",
        "turn_fields": [
          [
            "claudeAiOauth",
            "scopes"
          ],
          [
            "claudeAiOauth",
            "subscriptionType"
          ],
          [
            "claudeAiOauth",
            "rateLimitTier"
